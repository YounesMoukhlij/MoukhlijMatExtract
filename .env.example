# Copy this file to .env (it is git-ignored) and fill in what you have. Every line is optional.

# Elsevier / ScienceDirect: a free API key from https://dev.elsevier.com/ ("I want an API key"),
# created while you are on your university's network. Without it, Elsevier papers can only come
# from open-access copies.
ELSEVIER_API_KEY=

# Only if Elsevier gave you an institutional token (it lets the key work from outside the campus network).
ELSEVIER_INSTTOKEN=

# Your contact address, sent to OpenAlex and Unpaywall (Unpaywall requires one) so they can reach
# you if a request ever misbehaves. It is never sent anywhere else.
AUTOMATEXTRACT_EMAIL=

# Optional: an OpenAlex API key.
OPENALEX_API_KEY=

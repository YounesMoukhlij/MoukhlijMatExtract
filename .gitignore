# The project's virtual environment (README: Install)
.venv/
venv/

# API keys and your email live here, never in git
.env

# Articles: someone else's copyright, not for a repository (and this one is public).
# Every PDF anywhere in the project, and the folders papers are put or downloaded into.
*.pdf
core/LocalExtraction/papers/*
!core/LocalExtraction/papers/.gitkeep
core/WebScraping/papers/

# Everything the programs write: run them to make it again
core/LocalExtraction/local_output/
core/WebScraping/web_output/
core/SelectingTopMaterial/results/
core/Classification/crystal_structure/
core/Classification/structure_families/
core/Classification/all_materials.csv
core/Classification/.*.writing/
core/WebScraping/Fetch_DOIs/dois.csv
core/WebScraping/Fetch_DOIs/dois.txt
core/WebScraping/Fetch_DOIs/dois.searched.json

# Build artifacts (upload these with twine, never commit them)
dist/
build/
*.egg-info/

# Python leaves these everywhere
__pycache__/
*.py[cod]
.pytest_cache/

# macOS, and the lock files Excel leaves next to a workbook it has open
.DS_Store
~$*

# The worked example's results (make demo)
resources/examples/output/
# ... except the worked example's two CC BY papers (resources/examples/README.md)
!resources/examples/papers/*.pdf
